# Copia este archivo como .env y llena los valores

# PostgreSQL (en Azure agrega ?sslmode=verify-full al final)
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/wallet

# Cliente de Open Payments: la wallet y la llave que creaste en wallet.interledger-test.dev
OP_CLIENT_WALLET=https://ilp.interledger-test.dev/tu-wallet-cliente
OP_KEY_ID=el-key-id-de-tu-llave
# En local: ruta al archivo de la llave. En Azure usa OP_PRIVATE_KEY con el contenido en base64
OP_PRIVATE_KEY_PATH=private.key
# OP_PRIVATE_KEY=

# Wallet del administrador (recibe los pagos). Debe estar en USD
ADMIN_WALLET=https://ilp.interledger-test.dev/wallet-del-conjunto
CONJUNTO_NOMBRE=Conjunto Residencial Los Almendros

PORT=3000
# Opcional: URL pública si la app está detrás de un proxy raro
# PUBLIC_URL=https://tu-app.azurewebsites.net
